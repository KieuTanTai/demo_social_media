@{
    var authError = TempData["AuthError"]?.ToString();
    var hasAuthError = !string.IsNullOrWhiteSpace(authError);
}

<div
    class="auth-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 @(hasAuthError ? "is-visible" : "")"
    data-auth-overlay @(!hasAuthError ? "hidden" : "")>
    <section class="auth-popup relative w-full max-w-md bg-(--surface) p-5 shadow-xl"
             role="dialog" aria-modal="true" aria-label="Account form">
        <button
            class="auth-close absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center text-white bg-(--button-danger) hover:bg-(--button-danger-hover)"
            type="button" aria-label="Close popup" data-auth-close>X
        </button>

        <form class="auth-form active space-y-4" data-auth-form="login" method="post"
              asp-controller="Auth" asp-action="Login">
            @Html.AntiForgeryToken()
            <div class="auth-heading mb-1">
                <h2>Login</h2>
            </div>
            <label class="auth-field block">
                <span>Email</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="email" name="email" autocomplete="email"/>
            </label>
            <label class="auth-field block">
                <span>Password</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="password" name="password" autocomplete="current-password"/>
            </label>
            <div class="auth-message" role="alert" data-auth-message @(!hasAuthError ? "hidden" : "")>@authError</div>
            <div class="auth-links flex gap-3 text-sm">
                <button class="auth-switch-link text-(--accent) hover:underline" type="button"
                        data-auth-switch="signup">
                    Register
                </button>
                <button class="auth-switch-link text-(--accent) hover:underline" type="button"
                        data-auth-switch="forgot">
                    Forgot password
                </button>
            </div>
            <button class="auth-submit h-10 w-full px-4 font-medium text-white" type="submit">Login</button>
        </form>

        <form class="auth-form space-y-4" data-auth-form="signup" novalidate>
            @Html.AntiForgeryToken()
            <div class="auth-heading mb-1">
                <h2>Register</h2>
            </div>
            <label class="auth-field block">
                <span>Full name</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="text" name="fullName" autocomplete="name" required/>
            </label>
            <label class="auth-field block">
                <span>Email</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="email" name="email" autocomplete="email" required/>
            </label>
            <label class="auth-field block">
                <span>Password</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="password" name="password" autocomplete="new-password" required/>
            </label>
            <label class="auth-field block">
                <span>Confirm</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="password" name="confirmPassword" autocomplete="new-password" required/>
            </label>
            <div class="auth-message" role="alert" data-auth-message hidden></div>
            <div class="auth-links text-sm">
                <button class="auth-switch-link text-(--accent) hover:underline" type="button" data-auth-switch="login">
                    Login
                </button>
            </div>
            <button class="auth-submit h-10 w-full px-4 font-medium text-white" type="submit">Register</button>
        </form>

        <form class="auth-form space-y-4" data-auth-form="forgot" data-forgot-form novalidate>
            @Html.AntiForgeryToken()
            <div class="auth-heading mb-1">
                <h2>Forgot password</h2>
            </div>
            <label class="auth-field block" data-forgot-step="email">
                <span>Email</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="email" name="registeredEmail" autocomplete="email" required/>
            </label>
            <label class="auth-field block" data-forgot-step="code" hidden>
                <span>Passcode</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="text" name="passcode" inputmode="numeric" autocomplete="one-time-code" required/>
            </label>
            <label class="auth-field block" data-forgot-step="reset" hidden>
                <span>New password</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="password" name="newPassword" autocomplete="new-password" required/>
            </label>
            <label class="auth-field block" data-forgot-step="reset" hidden>
                <span>Confirm</span>
                <input class="mt-1 h-10 w-full border px-3 text-sm outline-none ring-(--accent) focus:ring-2"
                       type="password" name="confirmNewPassword" autocomplete="new-password" required/>
            </label>
            <div class="auth-message" role="alert" data-auth-message hidden></div>
            <div class="auth-links flex gap-3 text-sm">
                <button class="auth-switch-link text-(--accent) hover:underline" type="button" data-auth-switch="login">
                    Login
                </button>
                <button class="auth-switch-link text-(--accent) hover:underline" type="button"
                        data-auth-switch="signup">Register
                </button>
            </div>
            <button class="auth-submit h-10 w-full px-4 font-medium text-white" type="button" data-forgot-next="code">
                Send passcode
            </button>
            <button class="auth-submit h-10 w-full px-4 font-medium text-white" type="button" data-forgot-next="reset"
                    hidden>Verify passcode
            </button>
            <button class="auth-submit h-10 w-full px-4 font-medium text-white" type="submit" data-forgot-submit hidden>
                Save new password
            </button>
        </form>
    </section>
</div>
